# ──── Python / UV ────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ──── Data (large / generated) ────
data/processed/
*.parquet

# ──── Results (re-generatable) ────
# Track experiment configs but not outputs
results/*/schedules/
results/*/analysis/
results/**/run_log.txt
results/**/run.log
results/autoresearch/
!results/exp001_baseline01/schedules/
!results/exp001_baseline01/schedules/*.txt

# ──── Notebooks ────
# .ipynb files are build artifacts (generated from fragments/)
notebooks/**/*.ipynb
.ipynb_checkpoints/
# Notebook cache artifacts (regeneratable PNG/CSV); paper figures live in paper/assets/
output/

# ──── Scratch ────
# One-off throwaway scripts/notes (see AGENTS.md)
tmp/

# ──── Paper build artifacts ────
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# ──── OS ────
.DS_Store
Thumbs.db

# ──── IDE ────
.idea/
.vscode/
*.swp
*.swo
