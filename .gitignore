# ──── Python / UV ────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Built paper PDFs are published artifacts
!paper/dist/
!paper/dist/*.pdf

# ──── Data (large / generated) ────
data/processed/
*.parquet

# ──── Results (re-generatable) ────
# Track experiment configs but not outputs
results/*/schedules/
results/*/analysis/
results/**/run_log.txt
results/**/run.log
results/autoresearch/
!results/exp001_baseline01/schedules/
!results/exp001_baseline01/schedules/*.txt

# ──── Notebooks ────
# Scratch/checkpoint .ipynb are ignored; the 3 published suite notebooks are tracked.
notebooks/**/*.ipynb
!notebooks/01_data_and_problem/01_data_and_problem.ipynb
!notebooks/02_paper_figures/02_paper_figures.ipynb
!notebooks/03_results_report/03_results_report.ipynb
.ipynb_checkpoints/
# Notebook cache artifacts (regeneratable PNG/CSV); paper figures live in paper/assets/
output/

# ──── Scratch ────
# One-off throwaway scripts/notes (see AGENTS.md)
tmp/

# ──── Paper build artifacts ────
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# ──── OS ────
.DS_Store
Thumbs.db

# ──── IDE ────
.idea/
.vscode/
*.swp
*.swo
